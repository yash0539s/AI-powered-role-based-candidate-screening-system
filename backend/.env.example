# --- LLM: Groq (free key at https://console.groq.com/keys) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.4

# --- Embeddings (local, downloaded automatically on first run) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://...) ---
# DATABASE_URL=sqlite:///./data/screening.db
# CHROMA_DIR=./data/chroma
# BOOKS_DIR=./data/books

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATES=20
RETRIEVAL_MIN_SIMILARITY=0.45
MMR_LAMBDA=0.7

# --- Interview ---
DEFAULT_NUM_QUESTIONS=6
MAX_FOLLOW_UPS_PER_TOPIC=1

# --- API ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
